{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\uae30\uc220\ubb38\uc11c \ubaa8\uc74c","text":"<p>\uc774 \uc0ac\uc774\ud2b8\ub294 \uae30\uc220\ubb38\uc11c\ub97c \uc815\ub9ac\ud558\ub294 \uacf5\uac04\uc785\ub2c8\ub2e4.</p> <ul> <li> <p> Claude</p> <p>Claude \uad00\ub828 \ubb38\uc11c</p> <p> \ubc14\ub85c\uac00\uae30</p> </li> <li> <p>:simple-openai:{ .lg .middle } Codex</p> <p>Codex \uad00\ub828 \ubb38\uc11c</p> <p> \ubc14\ub85c\uac00\uae30</p> </li> <li> <p> AI Agent \ud65c\uc6a9 \ud301</p> <p>AI Agent \uc2e4\uc804 \ud65c\uc6a9 \ud301</p> <p> \ubc14\ub85c\uac00\uae30</p> </li> <li> <p> MCP</p> <p>MCP \uad00\ub828 \ubb38\uc11c</p> <p> \ubc14\ub85c\uac00\uae30</p> </li> </ul>"},{"location":"getting-started/","title":"\uc2dc\uc791\ud558\uae30","text":""},{"location":"getting-started/#_2","title":"\ubb38\uc11c \ucd94\uac00 \ubc29\ubc95","text":"<ol> <li><code>docs/</code> \ud3f4\ub354 \uc544\ub798\uc5d0 <code>.md</code> \ud30c\uc77c \ucd94\uac00</li> <li><code>mkdocs.yml</code>\uc758 <code>nav</code> \ud56d\ubaa9\uc5d0 \uacbd\ub85c \ucd94\uac00</li> <li>\ucee4\ubc0b \ud6c4 \ud478\uc2dc\ud558\uba74 \uc790\ub3d9 \ubc30\ud3ec</li> </ol>"},{"location":"getting-started/#_3","title":"\ub85c\uceec \ubbf8\ub9ac\ubcf4\uae30","text":"<pre><code>pip install mkdocs-material\nmkdocs serve\n</code></pre> <p><code>http://127.0.0.1:8000</code> \uc5d0\uc11c \ud655\uc778 \uac00\ub2a5\ud569\ub2c8\ub2e4.</p>"},{"location":"ai-agent-tips/","title":"AI Agent \ud65c\uc6a9 \ud301","text":"<p>AI Agent \ud65c\uc6a9 \ud301 \uce74\ud14c\uace0\ub9ac\uc785\ub2c8\ub2e4.</p>"},{"location":"ai-agent-tips/#_1","title":"\ubb38\uc11c","text":"<ul> <li>Codex vs Claude Code</li> <li>Skills vs Plugins</li> </ul>"},{"location":"ai-agent-tips/AgentTeams/","title":"AgentTeams","text":""},{"location":"ai-agent-tips/AgentTeams/#agent-teams","title":"Agent Teams","text":"<p>Agent Teams\ub294 \uc5ec\ub7ec Claude Code \uc778\uc2a4\ud134\uc2a4\uac00 \ud558\ub098\uc758 \ud300\uc73c\ub85c \ud611\uc5c5\ud558\ub294 \uae30\ub2a5\uc785\ub2c8\ub2e4. \ud558\ub098\uc758 \uc138\uc158\uc774 \ub9ac\ub4dc(Lead) \uc5ed\ud560\ub85c \uc791\uc5c5\uc744 \uc870\uc728\ud558\uace0 \ud0dc\uc2a4\ud06c\ub97c \ud560\ub2f9\ud558\uba70 \uacb0\uacfc\ub97c \uc885\ud569\ud569\ub2c8\ub2e4. \ud300\uc6d0(Teammate)\uc740 \uac01\uc790 \ub3c5\ub9bd\ub41c \ucee8\ud14d\uc2a4\ud2b8 \uc708\ub3c4\uc6b0\uc5d0\uc11c \uc791\uc5c5\ud558\uace0, \uc11c\ub85c \uc9c1\uc811 \uba54\uc2dc\uc9c0\ub97c \uc8fc\uace0\ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"ai-agent-tips/AgentTeams/#warning","title":"warning","text":"<p>Agent Teams\ub294 \uc2e4\ud5d8\uc801 \uae30\ub2a5\uc73c\ub85c \uae30\ubcf8 \ube44\ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ud300\uc6d0\ub9c8\ub2e4 \ub3c5\ub9bd\ub41c \ucee8\ud14d\uc2a4\ud2b8 \uc708\ub3c4\uc6b0\ub97c \uc0ac\uc6a9\ud558\ubbc0\ub85c \ub2e8\uc77c \uc138\uc158\ubcf4\ub2e4 \ud1a0\ud070\uc744 \ud6e8\uc52c \ub9ce\uc774 \uc18c\ube44\ud569\ub2c8\ub2e4.</p> <p>\ub9ac\ub4dc\uc640 \ud300\uc6d0\uc774 \uacf5\uc720 \ud0dc\uc2a4\ud06c \ub9ac\uc2a4\ud2b8\ub85c \uc791\uc5c5\uc744 \uad00\ub9ac\ud569\ub2c8\ub2e4. \ub9ac\ub4dc\uac00 \ud0dc\uc2a4\ud06c\ub97c \uc9c1\uc811 \ud560\ub2f9\ud560 \uc218\ub3c4 \uc788\uace0, \ud300\uc6d0\uc774 \ub0a8\uc740 \ud0dc\uc2a4\ud06c\ub97c \uc2a4\uc2a4\ub85c \uac00\uc838\uac08(Self-claim) \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \uc791\uc5c5\uc5d0\ub294 3~5\uba85 \uaddc\ubaa8\uc758 \ud300\uc774 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \uac00\uc124\ub85c \ub098\ub204\uc5b4 \uc9c4\ud589\ud558\ub294 \ub514\ubc84\uae45, \ud504\ub860\ud2b8\uc5d4\ub4dc\uc640 \ubc31\uc5d4\ub4dc\ucc98\ub7fc \ub808\uc774\uc5b4 \uac04 \uc870\uc728\uc774 \ud544\uc694\ud55c \uae30\ub2a5 \uad6c\ud604, \ub9ac\uc11c\uce58\uc640 \ub9ac\ubdf0 \uc791\uc5c5\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.</p> <p>CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS \ud658\uacbd \ubcc0\uc218\ub97c \uc124\uc815\ud574 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4.</p> <pre><code>.claude/settings.jsonJSON\n{\n  \"env\": {\n    \"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS\": \"1\"\n  }\n}\n</code></pre> <p>\ubcc4\ub3c4 \uba85\ub839 \uc5c6\uc774 \uc790\uc5f0\uc5b4\ub85c \ud300 \uad6c\uc131\uc744 \uc694\uccad\ud558\uba74 \ub429\ub2c8\ub2e4.</p> <pre><code>PROMPT\n\ud300\uc6d0 3\uba85\uc744 \ub9cc\ub4e4\uc5b4\uc11c \uc774 \ubc84\uadf8\uc758 \uc6d0\uc778\uc744 \uc11c\ub85c \ub2e4\ub978 \uac00\uc124\ub85c \uc870\uc0ac\ud574 \uc918\n</code></pre> <p>Dynamic Workflows\uc640\uc758 \ube44\uad50\ud574\uc11c \ub450 \uae30\ub2a5 \ubaa8\ub450 \uc5ec\ub7ec \uc5d0\uc774\uc804\ud2b8\ub97c \ud65c\uc6a9\ud558\uc9c0\ub9cc, \uacc4\ud68d\uc744 \ub204\uac00 \ub4e4\uace0 \uc788\ub294\uc9c0\uac00 \ub2e4\ub985\ub2c8\ub2e4. Dynamic Workflow\ub294 \uacc4\ud68d\uc744 \ucf54\ub4dc\ub85c \uc62e\uae34 \uac83\uc785\ub2c8\ub2e4. \uc2a4\ud06c\ub9bd\ud2b8\uac00 \ub8e8\ud504, \ubd84\uae30, \uc911\uac04 \uacb0\uacfc\ub97c \uc9c1\uc811 \ub4e4\uace0 \uc788\uc5b4 Claude\uc758 \ucee8\ud14d\uc2a4\ud2b8\uc5d0\ub294 \ucd5c\uc885 \uacb0\uacfc\ub9cc \ub0a8\uc2b5\ub2c8\ub2e4. \ubc18\uba74 Agent Teams\ub294 \ub9ac\ub4dc \uc5d0\uc774\uc804\ud2b8\uac00 \uc624\ucf00\uc2a4\ud2b8\ub808\uc774\ud130\ub85c\uc11c \ud134\ub9c8\ub2e4 \ub2e4\uc74c\uc5d0 \ubb34\uc5c7\uc744 \ud560\uc9c0 \uacb0\uc815\ud558\uace0, \uc9c4\ud589 \uc0c1\ud669\uc744 \uacf5\uc720 \ud0dc\uc2a4\ud06c \ub9ac\uc2a4\ud2b8\ub85c \uad00\ub9ac\ud569\ub2c8\ub2e4.</p> <p>**\ud1a0\ud070 \uc0ac\uc6a9\ub7c9\uc740 subagent\ubcf4\ub2e4 \ub9ce\uc744 \uc218 \ubc16\uc5d0\uc5c6\uc74c. !</p> <p>|-|-|-\uad6c\ubd84    Dynamic Workflows   Agent Teams \uacc4\ud68d \ubcf4\uc720   \uc2a4\ud06c\ub9bd\ud2b8(\ucf54\ub4dc)    \ub9ac\ub4dc \uc5d0\uc774\uc804\ud2b8(\ud134 \ub2e8\uc704 \uacb0\uc815) \uaddc\ubaa8  \ud55c \ubc88\uc5d0 \uc218\uc2ed~\uc218\ubc31 \uac1c \uc5d0\uc774\uc804\ud2b8   \uc18c\uc218(3~5\uba85)\uc758 \uc7a5\uae30 \uc2e4\ud589 \ud300\uc6d0 \uc5d0\uc774\uc804\ud2b8 \uac04 \ud1b5\uc2e0   \uc5c6\uc74c(\uc2a4\ud06c\ub9bd\ud2b8\uc5d0\ub9cc \uacb0\uacfc \ubcf4\uace0)    \ud300\uc6d0 \uac04 \uc9c1\uc811 \uba54\uc2dc\uc9d5 \uc911\uac04 \uacb0\uacfc \uc704\uce58    \uc2a4\ud06c\ub9bd\ud2b8 \ubcc0\uc218 \uacf5\uc720 \ud0dc\uc2a4\ud06c \ub9ac\uc2a4\ud2b8 \uc2e4\ud589 \uc911 \uc0ac\uc6a9\uc790 \uac1c\uc785 \ubd88\uac00  \uac00\ub2a5(\ub9ac\ub4dc\uc640 \ub300\ud654) \uc801\ud569\ud55c \uc791\uc5c5  \ub300\uaddc\ubaa8 \uc77c\uad04 \uc791\uc5c5(\ubc84\uadf8 \uc2a4\uc715, \ub9c8\uc774\uadf8\ub808\uc774\uc158, \uad50\ucc28 \uac80\uc99d \ub9ac\uc11c\uce58) \ud611\uc5c5\uc774 \ud544\uc694\ud55c \uc791\uc5c5(\uac00\uc124 \ubd84\ub2f4 \ub514\ubc84\uae45, \ub808\uc774\uc5b4 \uac04 \uc870\uc728)</p>"},{"location":"ai-agent-tips/Codex-vs-ClaudeCode/","title":"Codex vs Claude Code","text":"<p>Codex vs Claude Code</p>"},{"location":"ai-agent-tips/Codex-vs-ClaudeCode/#_1","title":"\uac15\uc758 \uac1c\uc694 \ubc0f \ubaa9\ud45c","text":"<p>\ud074\ub85c\ub4dc\ucf54\ub4dc \ub9cc\ub4e0\uc0ac\ub78c\ub3c4 \uc9c1\uc811 \ucf54\ub529\ud558\uc9c0\uc54a\uace0 \uc788\uc74c(\uc5ec\ub7ec\uac1c\uc758 \ud074\ub85c\ub4dc\ucc3d\uc744 \ub744\uc6cc\uc11c \uc77c\uc2dc\ud0a4\uace0 \uc2e4\uc218\ub294 \uacc4\uc18d \ud559\uc2b5\uae30\ub85d\uc2dc\ucf1c\uc11c \uace0\ub3c4\ud654\ud568)</p> <p>Agent.md\ub294 \ub9e4\uc791\uc5c5\ub9c8\ub2e4 \ucc38\uc870\ud558\ub294 \ud504\ub85c\uc81d\ud2b8 \uc0c1\uc2dc \uba54\ubaa8\ub9ac \ud30c\uc77c</p> <ul> <li>agent\uac00 \ud56d\uc0c1 \uae30\uc5b5\ud574\uc57c\ud558\ub294 \uacf5\ud1b5 \uaddc\uce59\uc744 \ub2f4\ub294\uac83</li> <li>\uc5d4\ud130 \uce60\ub54c\ub9c8\ub2e4 context\uc5d0 \ud3ec\ud568\ub418\uc5b4 \ud1a0\ud070\uc744 \uc0ac\uc6a9\ud558\uac8c\ub428</li> <li>context\ub294 \uac15\uc81c\uc0ac\ud56d\uc774 \uc544\ub2c8\ub77c\uc11c, \uac15\ud558\uac8c \ucc38\uc870\ud558\ub294 \uc815\ub3c4\ub77c \ubc18\ub4dc\uc2dc \uc9c0\ucf1c\uc9c0\ub294\uc9c0\ub294 \ud655\uc2e0\ud560\uc218\uc5c6\uc74c</li> <li></li> </ul> <p>\uc77c \uc2dc\ud0a4\ub294\ubc95</p> <ol> <li>Exolore \ud0d0\uc0c9</li> <li>Plan  - \uad6c\ud604\uc9c1\uc804\uc5d0 \uacc4\ud68d\uc744 \uc6b0\uc120 \uc218\ub9bd\ud55c\ub2e4. \uc694\uad6c\uc0ac\ud56d \uc218\uc815 \ubc94\uc704 \uc9c0\uc815</li> <li>Code - \uc791\uc740\ub2e8\uc704\ubcc4\ub85c \uacc4\ud68d \ubc94\uc704\uc548\uc5d0\uc11c \uc218\uc815\uc9c4\ud589</li> <li>Test - \ub2e8\uc704 \ud14c\uc2a4\ud2b8, \ud1b5\ud569 \ud14c\uc2a4\ud2b8</li> <li>Commit - \uac80\uc99d \ubc0f \ud14c\uc2a4\ud2b8 \ud1b5\uacfc \ud6c4 \ucee4\ubc0b</li> </ol> <p>Agent\uad6c\uc131\uc740 </p> <p>1.Command</p> <p>\uc790\uc8fc\uc0ac\uc6a9\ud558\ub294 \ud504\ub86c\ud504\ud2b8 \uc791\uc5c5\uc744 \ub2e8\ucd95\uba85\ub839\ucc98\ub7fc \uc7ac\uc0ac\uc6a9\ud558\ub294 \uc2dc\uc2a4\ud15c</p> <p>1.\ubb34\uc5c7\uc744 \uc54c\uace0\uc788\ub0d0 claude.md agent.md</p> <p>2.\ubb34\uc5c7\uc744 \uc5b4\ub5bb\uac8c \ud560 \uc218 \uc788\ub294\uac00? seetings.json, config.toml </p> <p>3.\uc5b4\ub5a4 \uc791\uc5c5\uc744 \uac16\uace0\uc788\ub294\uac00 ? \ub300\ud654 \ucee8\ud14d\uc2a4\ud2b8</p> <p>\uc0c8\ub85c \uc2dc\uc791\ud560\ub54c\ub294 /clear</p> <p>/compact  - \ub2f5\ubcc0\uc774 \uae38\uc5b4\uc9c8\ub54c\ub3c4 \uc720\uc758\ubbf8</p> <p>\ub300\ud654\uac00 \uc774\uc5b4\uc9c0\uae34\ud55c\ub370 \uadf8\ub300\ub85c \uc0ac\uc6a9\ud558\uae30\ubcf4\ub2e4, summarize conversation.</p> <p>\ubcf5\uc7a1\ud55c\uc124\uacc4.\ub9ac\ud329\ud1a0\ub9c1 \u2192\uace0\uae09\ubaa8\ub378</p> <p>\ub2e8\uc21c\ucf54\ub529 \ub514\ubc84\uae45 \u2192\uc77c\ubc18 \ubaa8\ub378 , \uc18c\ub137\uc815\ub3c4</p> <p>\ud074\ub85c\ub4dc</p> <p>/context \uba85\ub839\uc5b4, \uc5bc\ub9c8\ub098 context\uac00 \ub9ce\uc774 \uc7a1\uc544\uba39\uace0\uc788\ub294\uc9c0 \ud655\uc778 \ud560 \uc218\uc788\ub2e4.</p> <p>/statusline dir, git-branch, model, effort, remain token</p> <p>/effort \ud558\uba74 \uc798\uc548\uc4f0\ub294 \ud654\ub824\ud55c</p> <p>\uc548\ub4dc\ub808\uc544 \uce74\ud30c\uc2dc Agent.md</p> <p>\uac15\uc758 \uac1c\uc694 \ubc0f \ubaa9\ud45c (1)</p>"},{"location":"ai-agent-tips/FE_Taste_Skill/","title":"FE Taste Skill","text":"<p>Installing The npx skills add CLI scans the skills/ folder in this repo, so all skills below (code and image-generation) install the same way.</p> <p><pre><code>npx skills add https://github.com/Leonxlnx/taste-skill\n</code></pre> Install a single skill by its install name (the name: field inside the SKILL frontmatter, not the folder name):</p> <p><code>** npx skills add https://github.com/Leonxlnx/taste-skill --skill \"design-taste-frontend\"**</code> You can also copy any SKILL.md into your project or paste it into ChatGPT / Codex conversations.</p>"},{"location":"ai-agent-tips/skills-vs-plugins/","title":"Skills vs Plugins","text":""},{"location":"ai-agent-tips/skills-vs-plugins/#skills-vs-plugins","title":"Skills vs Plugins","text":"<p>https://www.heropy.dev/p/4weJmr</p>"},{"location":"claude/","title":"Claude","text":"<p>Claude \uad00\ub828 \uae30\uc220\ubb38\uc11c \uce74\ud14c\uace0\ub9ac\uc785\ub2c8\ub2e4.</p>"},{"location":"claude/#_1","title":"\ubb38\uc11c","text":"<ul> <li>Claude Cowork \ud575\uc2ec \uc815\ub9ac</li> </ul>"},{"location":"claude/AgentView/","title":"AgentView","text":""},{"location":"claude/AgentView/#agent-view","title":"Agent View","text":"<p>\uc791\uc5c5\uc911\uc778 Agent\ub4e4\uc744 background\uc5d0\uc11c \ubcf4\uad00\ud574\ub450\uace0 \ud574\ub2f9 \uc791\uc5c5\ub4e4\uc744 \ubcf4\uace0 \uc654\ub530\uac14\ub2e4 \ud560 \uc218\uc788\uc74c</p> <p>\uba85\ub839\uc5b4 \ub0a0\ub824\uc11c agent\uac00 \ucc98\ub9ac\ud558\ub294 \uc911\uc5d0 \uc67c\ucabd \ud654\uc0b4\ud45c &lt;- \ub204\ub974\uba74 bg\uc791\uc5c5\uc774 \ub418\uba74\uc11c \uc804\uccb4 \uc791\uc5c5\uc911\uc778 \ub9ac\uc2a4\ud2b8 view\uac00 \ub738</p> <p>\uadf8\uc0c1\ud0dc\uc5d0\uc11c \uc120\ud0dd\uc744\ud574\uc11c \ub2e4\ub978 agent\uc791\uc5c5\ud654\uba74\uc73c\ub85c \ub4e4\uc5b4\uac08 \uc218 \uc788\uc74c</p>"},{"location":"claude/ClaudeCowork/","title":"Claude Cowork \ud575\uc2ec \uc815\ub9ac","text":""},{"location":"claude/ClaudeCowork/#claude-cowork","title":"Claude Cowork \ud575\uc2ec \uc815\ub9ac","text":"<p>\ubc15\uc601\uc6c5 \uac15\uc0ac\ub2d8 \uc790\ub8cc https://www.heropy.dev/p/gECL4R</p>"},{"location":"claude/ClaudeCowork/#claude-plugins","title":"Claude\uc5d0\uc11c \uc720\uc6a9\ud55c Plugins \uc124\uce58 \ubc29\ubc95","text":"<pre><code>claude plugin marketplace add **anthropics/work-plugins**\n</code></pre>"},{"location":"claude/new-doc/","title":"\uc0c8 \ubb38\uc11c","text":""},{"location":"codex/","title":"Codex","text":"<p>Codex \uad00\ub828 \uae30\uc220\ubb38\uc11c \uce74\ud14c\uace0\ub9ac\uc785\ub2c8\ub2e4.</p>"},{"location":"codex/#_1","title":"\ubb38\uc11c","text":"<ul> <li>ClaudeCode \uac15\uc758\ub0b4\uc6a9</li> </ul>"},{"location":"codex/ClaudeCode/","title":"ClaudeCode\uac15\uc758\ub0b4\uc6a9","text":"<p>\ubc15\uc601\uc6c5 \uac15\uc0ac\ub2d8 \uac15\uc758</p> <p>\ud648\ud398\uc774\uc9c0 : HEROPY.DEV | HEROPY.DEV</p>"},{"location":"codex/ClaudeCode/#skills","title":"SKills\ub780?","text":"<p>: \ubc18\ubcf5\uc801\uc73c\ub85c Prompt\uc785\ub825\ud558\ub294 \ub0b4\uc6a9\uc744 \ubbf8\ub9ac \uc800\uc7a5\ud574\ub450\uace0 / \uc2ac\ub798\uc26c\ub85c \ud638\ucd9c\ud574\uc11c \uc0ac\uc6a9\ud558\ub294 \uae30\ub2a5</p> <p>: PR\uc774\ub098, \ucee4\ubc0b\ud478\uc26c\ub098 \uadf8\ub7f0\uac70\uc5d0 \ud65c\uc6a9 \uac00\ub2a5\ud560\ub4ef </p> <p>: \ud50c\ub7ec\uadf8\uc778\uc911\uc5d0 skill-creator\uac00\uc788\uc74c \uadf8\uac78\ub85c \ub0b4\uac00 \ub300\ucda9\ub9cc\ub4e0 skill\uc744 \uac1c\uc120\ud574\ub2ec\ub77c\uace0\ud558\uac70\ub098 \uc2e0\uaddc\uc0dd\uc131\ud558\uba74\ub428</p> <p>:\ud504\ub86c\ud504\ud2b8 \uc785\ub825\ucc3d\uc5d0\uc11c \uc904\ubc14\uafc8\uc740 \ubc31\uc2ac\ub798\uc26c\\ \uc5d4\ud130\ub098 alt+\uc5d4\ud130</p> <p>prd\ud3f4\ub354\uc5d0 \uc694\uad6c\uc0ac\ud56d\uc744 md\ud30c\uc77c\ub85c \ub123\uc5b4\uc11c \ud504\ub86c\ud504\ud2b8 \ub0b4\uc6a9\uc744 \uc785\ub825\ud574\ub454\ub2e4.</p>"},{"location":"codex/ClaudeCode/#find-skill-skill","title":"find-skill \ub4f1\ub85d\ud558\uae30 (skill \ucc3e\uae30 \uae30\ub2a5)","text":"<p>\uae30\uc874\uc5d0 \uc0ac\ub78c\ub4e4\uc774 \ub9cc\ub4e4\uc5b4\ub454 skills The Agent Skills Directory \ub4f1\ub85d\ub418\uc5b4\uc788\uc74c.</p> <p>\uc774\uc911\uc5d0 \uc778\uae30\uc21c\uc704 \uc870\ud68c\ud574\ubcf4\uba74 skills \ucc3e\uae30 skills\uac00 1\uc704\uc784 :  find-skills </p> <p>https://skills.sh \uc0ac\uc774\ud2b8\uc5d0\uc11c \uc2a4\ud0ac\uc744 \uac80\uc0c9\ud558\uac70\ub098, \ud639\uc740 \ub2e4\uc74c\uacfc \uac19\uc774 find-skills \uc2a4\ud0ac\uc744 \uc124\uce58\ud558\uace0 \ud074\ub85c\ub4dc\uc5d0\uc11c \uc790\uc5f0\uc5b4\ub85c \uac80\uc0c9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> <pre><code># find-skills \uc124\uce58\nnpx skills add https://github.com/vercel-labs/skills --skill find-skills\n\n# Claude Code \ud504\ub86c\ud504\ud2b8\uc5d0\uc11c \uc0ac\uc6a9\n\u276f /find-skills \ud504\ub860\ud2b8\uc5d4\ub4dc\uc5d0\uc11c \uc608\uc058\uac8c \ub514\uc790\uc778\uc744 \ud558\ub294 \uc2a4\ud0ac\uc744 \ucd94\ucc9c\ud574 \uc918.\n</code></pre>"},{"location":"codex/ClaudeCode/#bypasspermission","title":"ByPassPermission\uc124\uc815\ud574\ub450\uae30","text":"<p>.claude \ud3f4\ub354\ud558\uc704\uc5d0 settings.json\ud30c\uc77c \ub9cc\ub4e4\uace0</p> <pre><code>{\n    \"permissions\": {\n        \"defaultMode\": \"bypassPermissions\"\n    }\n}\n</code></pre>"},{"location":"mcp/","title":"MCP","text":"<p>MCP \uad00\ub828 \uae30\uc220\ubb38\uc11c \uce74\ud14c\uace0\ub9ac\uc785\ub2c8\ub2e4.</p>"},{"location":"mcp/new-doc/","title":"\uc0c8 \ubb38\uc11c","text":""}]}